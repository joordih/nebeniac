# syntax=docker/dockerfile:1
FROM node:18-alpine AS builder

WORKDIR /app

COPY dashboard/package*.json ./

RUN npm install -g pnpm

COPY dashboard/pnpm-lock.yaml* ./

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --no-strict-peer-dependencies

COPY dashboard/src ./src
COPY dashboard/public ./public
COPY dashboard/index.html ./
COPY dashboard/vite.config.js ./
COPY dashboard/components.json ./
COPY dashboard/jsconfig.json ./
COPY dashboard/eslint.config.js ./

ARG VITE_API_BASE_URL=http://localhost:8080/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN pnpm build

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY deploy/docker/nginx/default.conf /etc/nginx/conf.d/default.conf

RUN sed -i '/^user /d' /etc/nginx/nginx.conf && \
    chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && chown nginx:nginx /var/run/nginx.pid
USER nginx

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
